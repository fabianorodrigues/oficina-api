    },
    "item": [
        {
            "name": "00 - Auth",
            "item": [
                {
                    "name": "01 - Login Admin",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "type": "text",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "type": "text",
                                "value": "application/json"
                            }
                        ],
                        "url": "{{baseUrl}}/api/auth/funcionarios",
                        "auth": {
                            "type": "noauth"
                        },
                        "body": {
                            "raw": "{\"cpf\":\"{{adminCpf}}\",\"senha\":\"{{adminSenha}}\"}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            },
                            "mode": "raw"
                        }
                    },
                    "response": [

                    ],
                    "event": [
                        {
                            "script": {
                                "exec": [
                                    "pm.test(\u0027status 200\u0027, () =\u003e pm.response.to.have.status(200));",
                                    "const json = pm.response.json();",
                                    "pm.expect(json.accessToken, \u0027accessToken\u0027).to.be.a(\u0027string\u0027).and.not.empty;",
                                    "pm.environment.set(\u0027tokenAdmin\u0027, json.accessToken);"
                                ],
                                "type": "text/javascript"
                            },
                            "listen": "test"
                        }
                    ]
                },
